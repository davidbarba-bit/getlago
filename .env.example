LAGO_VERSION=v1.17.0

# Database
POSTGRES_USER=lago
POSTGRES_PASSWORD=changeme
POSTGRES_DB=lago
DATABASE_URL=postgresql://lago:changeme@db:5432/lago

# Redis
REDIS_URL=redis://redis:6379

# Rails
RAILS_ENV=production
RAILS_LOG_TO_STDOUT=true
SECRET_KEY_BASE=

# Lago
LAGO_API_URL=http://localhost:3000
LAGO_FRONT_URL=http://localhost

# Encryption (generate with: openssl rand -hex 16)
LAGO_RSA_PRIVATE_KEY=
ENCRYPTION_PRIMARY_KEY=
ENCRYPTION_DETERMINISTIC_KEY=
ENCRYPTION_KEY_DERIVATION_SALT=

# Email (opcional)
LAGO_FROM_EMAIL=noreply@yourdomain.com
# SMTP_ADDRESS=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=

# PDF service
LAGO_PDF_URL=http://pdf:3000

# Sidekiq
SIDEKIQ_CONCURRENCY=10

# Storage (local por defecto)
LAGO_USE_AWS_S3=false
# AWS_S3_BUCKET=
# AWS_S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
