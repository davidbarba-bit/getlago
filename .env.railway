# Variables para Railway — copia estas en cada servicio
# Los valores entre <> los obtienes de Railway al crear los addons

# --- API y Sidekiq ---
RAILS_ENV=production
RAILS_LOG_TO_STDOUT=true
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}
LAGO_API_URL=https://<tu-api-url>.up.railway.app
LAGO_FRONT_URL=https://<tu-front-url>.up.railway.app
LAGO_PDF_URL=https://<tu-pdf-url>.up.railway.app

# Genera estos con: openssl rand -hex 64
SECRET_KEY_BASE=<genera-con-openssl-rand-hex-64>

# Genera estos con: openssl rand -hex 16
ENCRYPTION_PRIMARY_KEY=<genera-con-openssl-rand-hex-16>
ENCRYPTION_DETERMINISTIC_KEY=<genera-con-openssl-rand-hex-16>
ENCRYPTION_KEY_DERIVATION_SALT=<genera-con-openssl-rand-hex-16>

# Genera con: openssl genrsa 2048 | base64 | tr -d '\n'
LAGO_RSA_PRIVATE_KEY=<genera-con-openssl>

LAGO_FROM_EMAIL=noreply@yourdomain.com
LAGO_USE_AWS_S3=false
SIDEKIQ_CONCURRENCY=5

# --- Frontend (solo estas dos) ---
# API_URL=https://<tu-api-url>.up.railway.app
# LAGO_DISABLE_SIGNUP=false
